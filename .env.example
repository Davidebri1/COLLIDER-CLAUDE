# API Keys — copy to .env and fill in your own keys
# Never commit .env to git — already excluded in .gitignore
#
# EXPO_PUBLIC_ prefix is required — Expo/Metro only inlines env vars into
# the client bundle when prefixed this way (no babel/dotenv plugin in this
# project to do it otherwise). NOTE: these still ship inside the built JS
# bundle and are extractable by anyone who unpacks the app — this only
# keeps keys out of git source, it is not a real secret store. A
# server-side proxy is the only fix for that (see TASKS.md B1).

# Groq (primary LLM provider) — comma-separated list for fallback/rotation
EXPO_PUBLIC_GROQ_API_KEYS=your-groq-key-1,your-groq-key-2

# OpenRouter (fallback LLM provider, video/audio generation)
EXPO_PUBLIC_OPENROUTER_API_KEY=your-openrouter-key

# Exa (primary web search)
EXPO_PUBLIC_EXA_API_KEY=your-exa-key

# Tavily (fallback web search)
EXPO_PUBLIC_TAVILY_API_KEY=your-tavily-key
